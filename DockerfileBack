# =============================================================================
# English Teacher Academy - Production Dockerfile
# Enhanced with Security, Performance, and Authentication Features
# =============================================================================

# -----------------------------------------------------------------------------
# Base Stage - Common dependencies
# -----------------------------------------------------------------------------
FROM python:3.11-slim as base

# Set environment variables for security and performance
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    libjpeg-dev \
    libpng-dev \
    libfreetype6-dev \
    liblcms2-dev \
    libwebp-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libxcb1-dev \
    curl \
    gettext \
    # Security tools
    ca-certificates \
    gnupg \
    lsb-release \
    # Logging and monitoring
    logrotate \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user with specific UID/GID for security
RUN groupadd -r -g 1000 django && useradd -r -g django -u 1000 django

# Set work directory
WORKDIR /app

# -----------------------------------------------------------------------------
# Dependencies Stage - Install Python packages
# -----------------------------------------------------------------------------
FROM base as dependencies

# Copy requirements
COPY requirements.txt .

# Upgrade pip and install Python dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip install --user --no-cache-dir -r requirements.txt

# -----------------------------------------------------------------------------
# Production Stage - Final application image
# -----------------------------------------------------------------------------
FROM python:3.11-slim as production

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    PATH="/home/django/.local/bin:$PATH" \
    DJANGO_SETTINGS_MODULE=EnglishTeacher.settings

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    libpq5 \
    libjpeg62-turbo \
    libpng16-16 \
    libfreetype6 \
    liblcms2-2 \
    libwebp6 \
    libharfbuzz0b \
    libfribidi0 \
    libxcb1 \
    gettext \
    curl \
    # Security essentials
    ca-certificates \
    # Log management
    logrotate \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user with specific UID/GID
RUN groupadd -r -g 1000 django && useradd -r -g django -u 1000 django

# Create app directories with proper permissions
RUN mkdir -p /app /app/staticfiles /app/media /app/logs /app/logs/security /app/temp && \
    chown -R django:django /app && \
    # Security: Set proper permissions
    chmod 755 /app && \
    chmod 755 /app/staticfiles && \
    chmod 755 /app/media && \
    chmod 750 /app/logs && \
    chmod 750 /app/logs/security && \
    chmod 755 /app/temp

# Copy Python packages from dependencies stage
COPY --from=dependencies --chown=django:django /root/.local /home/django/.local

# Set work directory
WORKDIR /app

# Copy application code
COPY --chown=django:django . .

# Copy entrypoint script and make it executable
COPY --chown=django:django entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Create logrotate configuration for application logs
RUN echo '/app/logs/*.log {\n\
    daily\n\
    missingok\n\
    rotate 30\n\
    compress\n\
    delaycompress\n\
    notifempty\n\
    copytruncate\n\
    su django django\n\
}' > /etc/logrotate.d/django-app

# Security: Remove sensitive files and set secure permissions
RUN find /app -name "*.pyc" -delete && \
    find /app -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true && \
    # Remove any potential sensitive files
    rm -f /app/.env* /app/secret_key.txt /app/.secret_key 2>/dev/null || true && \
    # Set secure permissions on sensitive directories
    chmod -R go-rwx /app/logs

# Switch to non-root user
USER django

# Health check with better error handling and security considerations
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health/ --max-time 10 --silent --show-error || exit 1

# Expose port
EXPOSE 8000

# Security: Add labels for better container management
LABEL maintainer="EnglishTeacher Academy" \
      version="2.0" \
      description="Secure Django application with authentication and logging" \
      security.level="high"

# Set entrypoint
ENTRYPOINT ["/entrypoint.sh"]

# Default command with enhanced security settings
CMD ["gunicorn", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "3", \
     "--worker-class", "sync", \
     "--worker-connections", "1000", \
     "--timeout", "120", \
     "--keep-alive", "2", \
     "--max-requests", "1000", \
     "--max-requests-jitter", "100", \
     "--preload", \
     "--access-logfile", "/app/logs/gunicorn_access.log", \
     "--error-logfile", "/app/logs/gunicorn_error.log", \
     "--log-level", "info", \
     "--capture-output", \
     "EnglishTeacher.wsgi:application"] 