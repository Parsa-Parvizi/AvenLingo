# ==============================================================================
# Development Environment Variables - TEMPLATE
# Copy this file to docker.env for local development
# ==============================================================================

# Django Core Settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-not-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
POSTGRES_DB=englishteacher_db
POSTGRES_USER=englishteacher_user
POSTGRES_PASSWORD=dev_password
POSTGRES_PORT=5432

# Cache Configuration (Disabled for Development)
CACHE_BACKEND=django.core.cache.backends.dummy.DummyCache

# Email Configuration (Console Backend)
