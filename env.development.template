# Security Settings (Relaxed)
SECURE_SSL_REDIRECT=False
RATELIMIT_ENABLE=False

# Logging
LOG_LEVEL=DEBUG
DJANGO_LOG_LEVEL=DEBUG

# Server Ports
HTTP_PORT=80
DJANGO_PORT=8000

# Development Mode
DEVELOPMENT_MODE=True

